# ===========================================================================
# Tariq Youhana Leon — Portfolio Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local to git.
# ===========================================================================

# ---------------------------------------------------------------------------
# SITE URL  (required in production)
# Used by sitemap.ts and rss.xml for absolute URLs.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tariqleon.com

# ---------------------------------------------------------------------------
# KEYSTATIC CMS STORAGE (optional — defaults to local)
# Set KEYSTATIC_STORAGE=github to switch from local file storage to the
# GitHub-backed Keystatic Cloud mode in production.
# NEXT_PUBLIC_VERCEL_GIT_REPO_OWNER and _SLUG are auto-injected by Vercel.
# ---------------------------------------------------------------------------
KEYSTATIC_STORAGE=github
NEXT_PUBLIC_VERCEL_GIT_REPO_OWNER=tariqleon
NEXT_PUBLIC_VERCEL_GIT_REPO_SLUG=portfolio
